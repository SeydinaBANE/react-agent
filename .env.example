# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # Required: Anthropic API key
AGENT_MODEL=claude-3-5-sonnet-20241022  # Default Claude model for the agent

# ── Brave Search ──────────────────────────────────────────────────────────────
BRAVE_API_KEY=BSA...                  # Optional: for web_search tool

# ── Qdrant (episodic memory) ──────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=agent_memory

# ── API ────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production  # HS256 secret, min 32 chars
JWT_ALGORITHM=HS256
API_RATE_LIMIT=60/minute               # Requests per minute per IP

# ── Agent behavior ────────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=15               # Max ReAct iterations per task
AGENT_TOOL_TIMEOUT=10                 # Seconds before tool execution is killed
AGENT_CODE_EXECUTOR_ENABLED=true      # Set false to disable code execution tool

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                       # json (prod) | pretty (dev)
PROMETHEUS_ENABLED=true

# ── File I/O tool (whitelist) ─────────────────────────────────────────────────
FILE_IO_ALLOWED_PATHS=/tmp,/workspace  # Comma-separated list of allowed root paths
